{
  "name": "@workspace/prettier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./config": {
      "types": "./src/config.d.ts",
      "default": "./src/config.js"
    },
    "./plugins/tailwindcss/name": {
      "types": "./src/plugins/tailwindcss/name.d.ts",
      "default": "./src/plugins/tailwindcss/name.js"
    },
    "./plugins/tailwindcss/options": {
      "types": "./src/plugins/tailwindcss/options.d.ts",
      "default": "./src/plugins/tailwindcss/options.js"
    },
    "./plugins/sort-imports/name": {
      "types": "./src/plugins/sort-imports/name.d.ts",
      "default": "./src/plugins/sort-imports/name.js"
    },
    "./plugins/sort-imports/options": {
      "types": "./src/plugins/sort-imports/options.d.ts",
      "default": "./src/plugins/sort-imports/options.js"
    }
  },
  "files": [
    "src"
  ],
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1"
  },
  "peerDependencies": {
    "@ianvs/prettier-plugin-sort-imports": ">=4.7.0",
    "prettier": ">=3.10.1",
    "prettier-plugin-tailwindcss": ">=0.8.1"
  },
  "peerDependenciesMeta": {
    "prettier-plugin-tailwindcss": {
      "optional": true
    },
    "@ianvs/prettier-plugin-sort-imports": {
      "optional": true
    }
  }
}
